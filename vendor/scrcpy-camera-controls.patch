+    /** The AF region as a rectangle of the active array. The stream is a centred crop of it at the current zoom. */
+    private MeteringRectangle[] afRectangles(float[] region) {
+        CameraCharacteristics c = characteristics();
+        Rect active = c == null ? null : c.get(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+        if (active == null || captureSize == null) {
+            return null;
+        }
+        // With CONTROL_ZOOM_RATIO, 3A regions use the active array's coordinates for the zoomed field of view.
+        float aw = active.width(), ah = active.height();
+        float streamRatio = (float) captureSize.getWidth() / captureSize.getHeight();
+        float vw = aw, vh = ah, x0 = 0, y0 = 0;
+        if (streamRatio > aw / ah) {
+            vh = aw / streamRatio;
+            y0 = (ah - vh) / 2;
+        } else {
+            vw = ah * streamRatio;
+            x0 = (aw - vw) / 2;
+        }
+        int x = Math.round(x0 + Math.max(0, region[0]) * vw);
+        int y = Math.round(y0 + Math.max(0, region[1]) * vh);
+        int w = Math.max(1, Math.min(Math.round(region[2] * vw), (int) aw - x));
+        int h = Math.max(1, Math.min(Math.round(region[3] * vh), (int) ah - y));
+        return new MeteringRectangle[] {new MeteringRectangle(x, y, w, h, MeteringRectangle.METERING_WEIGHT_MAX)};
+    }
