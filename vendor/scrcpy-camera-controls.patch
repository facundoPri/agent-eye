+    // ---------------------------------------------------------------- agent-eye: 3A controls
+
+    private CameraCharacteristics characteristics() {
+        try {
+            return ServiceManager.getCameraManager().getCameraCharacteristics(cameraId);
+        } catch (CameraAccessException e) {
+            Ln.w("Could not get camera characteristics");
+            return null;
+        }
+    }
+
+    /** Autofocus off and the lens held at a fixed distance, in diopters (1/m; 0 = infinity). */
+    private void applyManualFocus(CameraCharacteristics c, float diopters) {
+        int[] afModes = c == null ? null : c.get(CameraCharacteristics.CONTROL_AF_AVAILABLE_MODES);
+        Float min = c == null ? null : c.get(CameraCharacteristics.LENS_INFO_MINIMUM_FOCUS_DISTANCE);
+        boolean afOff = false;
+        if (afModes != null) {
+            for (int m : afModes) {
+                afOff |= m == CaptureRequest.CONTROL_AF_MODE_OFF;
+            }
+        }
+        if (!afOff || min == null || min <= 0) {
+            Ln.w("agent-eye-3a: unsupported=focus (this camera has no manual focus)");
+            return;
+        }
+        float d = Math.max(0, Math.min(diopters, min));
+        Ln.i("agent-eye-3a: set focus=" + d + " min=" + min);
+        requestBuilder.set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_OFF);
+        requestBuilder.set(CaptureRequest.LENS_FOCUS_DISTANCE, d);
+    }
+
+    private void apply3aLocks() {
+        assertCameraThread();
+        if (currentSession == null || requestBuilder == null) {
+            return;
+        }
+        CameraCharacteristics c = characteristics();
+        try {
+            if (aeLock) {
+                if (c != null && Boolean.TRUE.equals(c.get(CameraCharacteristics.CONTROL_AE_LOCK_AVAILABLE))) {
+                    requestBuilder.set(CaptureRequest.CONTROL_AE_LOCK, true);
+                } else {
+                    Ln.w("agent-eye-3a: unsupported=ae_lock");
+                }
+            }
+            if (awbLock) {
+                if (c != null && Boolean.TRUE.equals(c.get(CameraCharacteristics.CONTROL_AWB_LOCK_AVAILABLE))) {
+                    requestBuilder.set(CaptureRequest.CONTROL_AWB_LOCK, true);
+                } else {
+                    Ln.w("agent-eye-3a: unsupported=awb_lock");
+                }
+            }
+            setRepeatingRequest(currentSession, requestBuilder.build());
+            Ln.i("agent-eye-3a: locked ae=" + aeLock + " awb=" + awbLock);
+        } catch (CameraAccessException e) {
+            Ln.e("Camera error", e);
+        }
+    }
+
+    /** What the camera actually did, about twice a second: one parseable line on stdout. */
+    private void report3a(CaptureResult r) {
+        // Every frame counts towards the focus range, so a short autofocus hunt between two reports still shows.
+        Float f = r.get(CaptureResult.LENS_FOCUS_DISTANCE);
+        if (f != null) {
+            focusMin = Math.min(focusMin, f);
+            focusMax = Math.max(focusMax, f);
+        }
+        long now = System.nanoTime();
+        if (now - lastReportNs < 500_000_000L) {
+            return;
+        }
+        lastReportNs = now;
+        StringBuilder sb = new StringBuilder("agent-eye-3a:");
+        appendResult(sb, "focus", f);
+        if (focusMax >= 0) {
+            appendResult(sb, "focus_min", focusMin);
+            appendResult(sb, "focus_max", focusMax);
+        }
+        focusMin = Float.MAX_VALUE;
+        focusMax = -1;
+        appendResult(sb, "af_mode", r.get(CaptureResult.CONTROL_AF_MODE));
+        appendResult(sb, "af_state", r.get(CaptureResult.CONTROL_AF_STATE));
+        appendResult(sb, "lens_state", r.get(CaptureResult.LENS_STATE));
+        appendResult(sb, "ae_state", r.get(CaptureResult.CONTROL_AE_STATE));
+        appendResult(sb, "ae_lock", r.get(CaptureResult.CONTROL_AE_LOCK));
+        appendResult(sb, "awb_state", r.get(CaptureResult.CONTROL_AWB_STATE));
+        appendResult(sb, "awb_lock", r.get(CaptureResult.CONTROL_AWB_LOCK));
+        appendResult(sb, "exposure_ns", r.get(CaptureResult.SENSOR_EXPOSURE_TIME));
+        appendResult(sb, "iso", r.get(CaptureResult.SENSOR_SENSITIVITY));
+        Ln.i(sb.toString());
+    }
+
+    private static void appendResult(StringBuilder sb, String key, Object value) {
+        if (value != null) {
+            sb.append(' ').append(key).append('=').append(value);
+        }
+    }
+
     private void assertCameraThread() {
         assert Thread.currentThread() == cameraThread;
     }
